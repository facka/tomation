{
  "format": "tomation-spec",
  "version": 1,
  "meta": {
    "name": "Playground Tests",
    "url": "https://facka.github.io/tomation",
    "description": "Tests for the Tomation playground apps",
    "urls": [
      "https://facka.github.io/tomation"
    ],
    "compilerVersion": "1.5.1"
  },
  "pageElements": {
    "Login__usernameInput": {
      "tag": "input",
      "label": "Username",
      "where": {
        "id": "username"
      }
    },
    "Login__passwordInput": {
      "tag": "input",
      "label": "Password",
      "where": {
        "id": "password"
      }
    },
    "Login__submitButton": {
      "tag": "button",
      "label": "Submit",
      "where": {
        "id": "login-btn"
      }
    },
    "Login__message": {
      "tag": "div",
      "label": "Message",
      "where": {
        "id": "message"
      }
    },
    "Navigation__pageTitle": {
      "tag": "h1",
      "label": "Page Title",
      "where": {
        "id": "page-title"
      }
    },
    "Navigation__stepIndicator": {
      "tag": "div",
      "label": "Step Indicator",
      "where": {
        "id": "step-indicator"
      }
    },
    "Navigation__successMessage": {
      "tag": "div",
      "label": "Success Message",
      "where": {
        "id": "success-message"
      }
    },
    "Todo__input": {
      "tag": "input",
      "label": "Todo Input",
      "where": {
        "id": "todo-input"
      }
    },
    "Todo__addButton": {
      "tag": "button",
      "label": "Add Button",
      "where": {
        "id": "add-btn"
      }
    },
    "Todo__list": {
      "tag": "ul",
      "label": "Todo List",
      "where": {
        "id": "todo-list"
      }
    },
    "Todo__firstItem": {
      "tag": "li",
      "label": "First Item",
      "where": {
        "classIncludes": "todo-item"
      }
    },
    "Todo__firstItemText": {
      "tag": "span",
      "label": "Item Text",
      "where": {
        "classIncludes": "todo-text"
      }
    },
    "Todo__deleteButton": {
      "tag": "button",
      "label": "Delete Button",
      "where": {
        "classIncludes": "delete-btn"
      }
    },
    "UserForm__nameInput": {
      "tag": "input",
      "label": "Full Name",
      "where": {
        "id": "full-name"
      }
    },
    "UserForm__emailInput": {
      "tag": "input",
      "label": "Email",
      "where": {
        "id": "email"
      }
    },
    "UserForm__phoneInput": {
      "tag": "input",
      "label": "Phone",
      "where": {
        "id": "phone"
      }
    },
    "UserForm__dobInput": {
      "tag": "input",
      "label": "Date of Birth",
      "where": {
        "id": "dob"
      }
    },
    "UserForm__roleSelect": {
      "tag": "select",
      "label": "Role",
      "where": {
        "id": "role"
      }
    },
    "UserForm__skillsSelect": {
      "tag": "select",
      "label": "Tech Skills",
      "where": {
        "id": "skills"
      }
    },
    "UserForm__addressInput": {
      "tag": "input",
      "label": "Address",
      "where": {
        "id": "address"
      }
    },
    "UserForm__juniorRadio": {
      "tag": "input",
      "label": "Junior Seniority",
      "where": {
        "id": "seniority-junior"
      }
    },
    "UserForm__semiseniorRadio": {
      "tag": "input",
      "label": "Semisenior Seniority",
      "where": {
        "id": "seniority-semisenior"
      }
    },
    "UserForm__seniorRadio": {
      "tag": "input",
      "label": "Senior Seniority",
      "where": {
        "id": "seniority-senior"
      }
    },
    "UserForm__registerButton": {
      "tag": "button",
      "label": "Register",
      "where": {
        "id": "register-btn"
      }
    },
    "UserForm__message": {
      "tag": "div",
      "label": "Message",
      "where": {
        "id": "message"
      }
    }
  },
  "tasks": {
    "Login__fillCredentials": {
      "steps": [
        {
          "action": "type",
          "target": "Login__usernameInput",
          "value": "{{username}}"
        },
        {
          "action": "typePassword",
          "target": "Login__passwordInput",
          "value": "{{password}}"
        }
      ],
      "params": [
        "username",
        "password"
      ],
      "label": "Fill Credentials"
    },
    "Login__fillInvalidCredentials": {
      "steps": [
        {
          "action": "type",
          "target": "Login__usernameInput",
          "value": "wronguser"
        },
        {
          "action": "typePassword",
          "target": "Login__passwordInput",
          "value": "wrongpass"
        }
      ],
      "params": [],
      "label": "Fill Invalid Credentials"
    },
    "Login__submit": {
      "steps": [
        {
          "action": "click",
          "target": "Login__submitButton"
        }
      ],
      "params": [],
      "label": "Submit Form"
    },
    "Navigation__verifyStep1": {
      "steps": [
        {
          "action": "assertHasText",
          "target": "Navigation__pageTitle",
          "value": "Welcome to the Wizard"
        },
        {
          "action": "assertHasText",
          "target": "Navigation__stepIndicator",
          "value": "Step 1 of 3"
        }
      ],
      "params": [],
      "label": "Verify Step 1"
    },
    "Navigation__verifyStep2": {
      "steps": [
        {
          "action": "assertHasText",
          "target": "Navigation__pageTitle",
          "value": "Provide Your Information"
        },
        {
          "action": "assertHasText",
          "target": "Navigation__stepIndicator",
          "value": "Step 2 of 3"
        }
      ],
      "params": [],
      "label": "Verify Step 2"
    },
    "Navigation__verifyStep3": {
      "steps": [
        {
          "action": "assertHasText",
          "target": "Navigation__pageTitle",
          "value": "Confirmation"
        },
        {
          "action": "assertHasText",
          "target": "Navigation__successMessage",
          "value": "Wizard completed successfully"
        },
        {
          "action": "assertHasText",
          "target": "Navigation__stepIndicator",
          "value": "Step 3 of 3"
        }
      ],
      "params": [],
      "label": "Verify Step 3"
    },
    "Todo__addItem": {
      "steps": [
        {
          "action": "type",
          "target": "Todo__input",
          "value": "{{text}}"
        },
        {
          "action": "click",
          "target": "Todo__addButton"
        }
      ],
      "params": [
        "text"
      ],
      "label": "Add Item"
    },
    "UserForm__fillForm": {
      "steps": [
        {
          "action": "type",
          "target": "UserForm__nameInput",
          "value": "{{name}}"
        },
        {
          "action": "type",
          "target": "UserForm__emailInput",
          "value": "{{email}}"
        },
        {
          "action": "type",
          "target": "UserForm__phoneInput",
          "value": "{{phone}}"
        },
        {
          "action": "type",
          "target": "UserForm__dobInput",
          "value": "{{dob}}"
        },
        {
          "action": "select",
          "target": "UserForm__roleSelect",
          "value": "{{role}}"
        },
        {
          "action": "select",
          "target": "UserForm__skillsSelect",
          "value": "{{skills}}"
        },
        {
          "action": "type",
          "target": "UserForm__addressInput",
          "value": "{{address}}"
        },
        {
          "action": "if",
          "condition": {
            "param": "isJunior",
            "op": "truthy"
          },
          "then": [
            {
              "action": "click",
              "target": "UserForm__juniorRadio"
            }
          ]
        },
        {
          "action": "if",
          "condition": {
            "param": "isSemisenior",
            "op": "truthy"
          },
          "then": [
            {
              "action": "click",
              "target": "UserForm__semiseniorRadio"
            }
          ]
        },
        {
          "action": "if",
          "condition": {
            "param": "isSenior",
            "op": "truthy"
          },
          "then": [
            {
              "action": "click",
              "target": "UserForm__seniorRadio"
            }
          ]
        }
      ],
      "params": [],
      "label": "Fill Registration Form"
    },
    "UserForm__submit": {
      "steps": [
        {
          "action": "click",
          "target": "UserForm__registerButton"
        }
      ],
      "params": [],
      "label": "Submit Registration"
    }
  },
  "tests": [
    {
      "name": "Login with valid credentials",
      "steps": [
        {
          "action": "task",
          "name": "Login__fillCredentials",
          "params": {
            "username": "admin",
            "password": "password123"
          }
        },
        {
          "action": "task",
          "name": "Login__submit"
        },
        {
          "action": "assertHasText",
          "target": "Login__message",
          "value": "Login successful"
        }
      ],
      "sourceFile": "login"
    },
    {
      "name": "Login with invalid credentials shows error",
      "steps": [
        {
          "action": "task",
          "name": "Login__fillInvalidCredentials"
        },
        {
          "action": "task",
          "name": "Login__submit"
        },
        {
          "action": "assertHasText",
          "target": "Login__message",
          "value": "Invalid username or password"
        }
      ],
      "sourceFile": "login"
    },
    {
      "name": "Login shows error on empty submit",
      "steps": [
        {
          "action": "click",
          "target": "Login__submitButton"
        },
        {
          "action": "assertHasText",
          "target": "Login__message",
          "value": "required"
        }
      ],
      "sourceFile": "login"
    },
    {
      "name": "Full wizard navigation flow",
      "steps": [
        {
          "action": "navigate",
          "url": "navigation/index.html"
        },
        {
          "action": "wait",
          "ms": 500
        },
        {
          "action": "task",
          "name": "Navigation__verifyStep1"
        },
        {
          "action": "navigate",
          "url": "page2.html"
        },
        {
          "action": "wait",
          "ms": 500
        },
        {
          "action": "task",
          "name": "Navigation__verifyStep2"
        },
        {
          "action": "navigate",
          "url": "page3.html"
        },
        {
          "action": "wait",
          "ms": 500
        },
        {
          "action": "task",
          "name": "Navigation__verifyStep3"
        }
      ],
      "sourceFile": "navigation"
    },
    {
      "name": "Navigate directly to confirmation page",
      "steps": [
        {
          "action": "navigate",
          "url": "./navigation/page3.html"
        },
        {
          "action": "wait",
          "ms": 300
        },
        {
          "action": "task",
          "name": "Navigation__verifyStep3"
        }
      ],
      "sourceFile": "navigation"
    },
    {
      "name": "Register a new patient with generated data",
      "steps": [
        {
          "action": "type",
          "target": "Login__usernameInput",
          "value": "{{data.patient.name}}"
        },
        {
          "action": "type",
          "target": "Login__passwordInput",
          "value": "{{data.patient.email}}"
        },
        {
          "action": "click",
          "target": "Login__submitButton"
        },
        {
          "action": "assertHasText",
          "target": "Login__message",
          "value": "Login successful"
        }
      ],
      "sourceFile": "registration",
      "data": {
        "patient": {
          "name": {
            "type": "fake",
            "method": "fullName",
            "options": {}
          },
          "dob": {
            "type": "fake",
            "method": "dateOfBirth",
            "options": {
              "minAge": 18,
              "maxAge": 65,
              "format": "MM/DD/YYYY"
            }
          },
          "phone": {
            "type": "fake",
            "method": "phone",
            "options": {
              "country": "US"
            }
          },
          "email": {
            "type": "fake",
            "method": "email",
            "options": {}
          },
          "address": {
            "type": "fake",
            "method": "address",
            "options": {}
          },
          "gender": {
            "type": "fake",
            "method": "oneOf",
            "options": {
              "values": [
                "Male",
                "Female",
                "Non-binary"
              ]
            }
          },
          "city": "Springfield"
        }
      }
    },
    {
      "name": "Verify patient data fields are populated",
      "steps": [
        {
          "action": "type",
          "target": "Login__usernameInput",
          "value": "{{data.patient.name}}"
        },
        {
          "action": "type",
          "target": "Login__passwordInput",
          "value": "{{data.patient.phone}}"
        },
        {
          "action": "type",
          "target": "Login__usernameInput",
          "value": "{{data.patient.dob}}"
        },
        {
          "action": "type",
          "target": "Login__passwordInput",
          "value": "{{data.patient.address}}"
        },
        {
          "action": "click",
          "target": "Login__submitButton"
        }
      ],
      "sourceFile": "registration",
      "data": {
        "patient": {
          "name": {
            "type": "fake",
            "method": "fullName",
            "options": {}
          },
          "dob": {
            "type": "fake",
            "method": "dateOfBirth",
            "options": {
              "minAge": 18,
              "maxAge": 65,
              "format": "MM/DD/YYYY"
            }
          },
          "phone": {
            "type": "fake",
            "method": "phone",
            "options": {
              "country": "US"
            }
          },
          "email": {
            "type": "fake",
            "method": "email",
            "options": {}
          },
          "address": {
            "type": "fake",
            "method": "address",
            "options": {}
          },
          "gender": {
            "type": "fake",
            "method": "oneOf",
            "options": {
              "values": [
                "Male",
                "Female",
                "Non-binary"
              ]
            }
          },
          "city": "Springfield"
        }
      }
    },
    {
      "name": "Add a todo item and verify it exists",
      "steps": [
        {
          "action": "task",
          "name": "Todo__addItem",
          "params": {
            "text": "Buy groceries"
          }
        },
        {
          "action": "assertExists",
          "target": "Todo__firstItem"
        },
        {
          "action": "assertHasText",
          "target": "Todo__firstItemText",
          "value": "Buy groceries"
        }
      ],
      "sourceFile": "todo"
    },
    {
      "name": "Delete a todo item and verify it is removed",
      "steps": [
        {
          "action": "type",
          "target": "Todo__input",
          "value": "Walk the dog"
        },
        {
          "action": "click",
          "target": "Todo__addButton"
        },
        {
          "action": "assertExists",
          "target": "Todo__firstItem"
        },
        {
          "action": "click",
          "target": "Todo__deleteButton"
        },
        {
          "action": "assertNotExists",
          "target": "Todo__firstItem"
        }
      ],
      "sourceFile": "todo"
    },
    {
      "name": "Add multiple items and verify text content",
      "steps": [
        {
          "action": "task",
          "name": "Todo__addItem",
          "params": {
            "text": "Read a book"
          }
        },
        {
          "action": "task",
          "name": "Todo__addItem",
          "params": {
            "text": "Write code"
          }
        },
        {
          "action": "assertExists",
          "target": "Todo__firstItem"
        },
        {
          "action": "assertHasText",
          "target": "Todo__list",
          "value": "Read a book"
        },
        {
          "action": "assertHasText",
          "target": "Todo__list",
          "value": "Write code"
        }
      ],
      "sourceFile": "todo"
    },
    {
      "name": "Register user with generated data",
      "steps": [
        {
          "action": "task",
          "name": "UserForm__fillForm",
          "params": {
            "name": "{{data.user.name}}",
            "email": "{{data.user.email}}",
            "phone": "{{data.user.phone}}",
            "dob": "{{data.user.dob}}",
            "role": "{{data.user.role}}",
            "skills": "TypeScript",
            "address": "{{data.user.address}}",
            "isSenior": true
          }
        },
        {
          "action": "task",
          "name": "UserForm__submit"
        },
        {
          "action": "assertHasText",
          "target": "UserForm__message",
          "value": "User registered successfully"
        }
      ],
      "sourceFile": "user-form",
      "data": {
        "user": {
          "name": {
            "type": "fake",
            "method": "fullName",
            "options": {}
          },
          "email": {
            "type": "fake",
            "method": "email",
            "options": {}
          },
          "phone": {
            "type": "fake",
            "method": "phone",
            "options": {
              "country": "US"
            }
          },
          "dob": {
            "type": "fake",
            "method": "dateOfBirth",
            "options": {
              "minAge": 18,
              "maxAge": 65,
              "format": "MM/DD/YYYY"
            }
          },
          "role": {
            "type": "fake",
            "method": "oneOf",
            "options": {
              "values": [
                "Admin",
                "Editor",
                "Viewer"
              ]
            }
          },
          "address": {
            "type": "fake",
            "method": "address",
            "options": {}
          }
        }
      }
    },
    {
      "name": "Register user shows error on empty submit",
      "steps": [
        {
          "action": "task",
          "name": "UserForm__submit"
        },
        {
          "action": "assertHasText",
          "target": "UserForm__message",
          "value": "All fields are required"
        }
      ],
      "sourceFile": "user-form"
    }
  ],
  "automations": [
    {
      "name": "Login",
      "params": [
        {
          "name": "username",
          "type": "string"
        },
        {
          "name": "password",
          "type": "string"
        }
      ],
      "steps": [
        {
          "action": "task",
          "name": "Login__fillCredentials",
          "params": {
            "username": "{{username}}",
            "password": "{{password}}"
          }
        },
        {
          "action": "task",
          "name": "Login__submit"
        }
      ],
      "sourceFile": "login"
    },
    {
      "name": "Todo__Add Todo Item",
      "params": [
        {
          "name": "item",
          "type": "string"
        }
      ],
      "steps": [
        {
          "action": "task",
          "name": "Todo__addItem",
          "params": {
            "text": "{{item}}"
          }
        },
        {
          "action": "assertExists",
          "target": "Todo__firstItem"
        },
        {
          "action": "saveText",
          "target": "Todo__firstItemText",
          "contextKey": "savedItem"
        },
        {
          "action": "assertHasText",
          "target": "Todo__firstItemText",
          "value": "{{item}}"
        },
        {
          "action": "assertHasText",
          "target": "Todo__firstItemText",
          "value": "{{ctx.savedItem}}"
        }
      ],
      "sourceFile": "todo"
    }
  ]
}